{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotchPulse",
  "version": "0.1.0",
  "identifier": "dev.notchpulse.desktop",
  "build": {
    "beforeDevCommand": "trunk serve",
    "beforeBuildCommand": "trunk build --release",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main",
      "title": "NotchPulse",
      "width": 460,
      "height": 380,
      "visible": false,
      "decorations": false,
      "transparent": true,
      "shadow": false,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "resizable": false,
      "focus": false,
      "acceptFirstMouse": true,
      "visibleOnAllWorkspaces": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": ["island"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "rpm"],
    "category": "DeveloperTool",
    "shortDescription": "Extraordinary open source. One quiet island.",
    "longDescription": "A Rust desktop companion for curated GitHub repositories, with platform-aware commands and an animated top-center island.",
    "copyright": "Copyright 2026 NotchPulse contributors",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    },
    "macOS": { "minimumSystemVersion": "12.0" },
    "linux": { "rpm": { "depends": ["webkit2gtk4.1", "gtk3", "libappindicator-gtk3"] } }
  }
}

